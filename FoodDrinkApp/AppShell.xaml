<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodDrinkApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodDrinkApp"
    Title="NutriBite"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light=#FFF5F7, Dark=#1A0A0F}"
    Shell.ForegroundColor="{AppThemeBinding Light=#4A2E35, Dark=#FFE8EC}"
    Shell.TitleColor="{AppThemeBinding Light=#4A2E35, Dark=#FFE8EC}"
    Shell.UnselectedColor="{AppThemeBinding Light=#D8A7B1, Dark=#8A5A68}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFF5F7, Dark=#1A0A0F}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#D8A7B1, Dark=#8A5A68}">

    <TabBar>
        <ShellContent
            Title="Foods"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Hardware"
            ContentTemplate="{DataTemplate local:HardwarePage}"
            Route="HardwarePage" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>
</Shell>