<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Nutrition Details">
    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#FFF5F7, Dark=#1A0A0F}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#FFE1E8, Dark=#2D121B}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>
        <VerticalStackLayout Padding="22" Spacing="16">
            <Border StrokeThickness="0" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light=#FF6B81, Dark=#801D33}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light=#FF8DA1, Dark=#A62B46}" Offset="0.62" />
                        <GradientStop Color="{AppThemeBinding Light=#FFA8B5, Dark=#CC4260}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#44FF6B81" Offset="0,8" Radius="18" Opacity="0.5" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Label x:Name="NameLabel"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label x:Name="CategoryLabel"
                           Grid.Row="1"
                           FontSize="15"
                           TextColor="#FFF0F5" />
                    <Label x:Name="CaloriesLabel"
                           Grid.Row="2"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FFE1E8" />
                </Grid>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#FFD1DC, Dark=#4A212E}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F0C14}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nutrition overview" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}" />
                    <Label x:Name="MacroLabel" FontSize="16" TextColor="{AppThemeBinding Light=#FF8DA1, Dark=#FFB3C6}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#FFD1DC, Dark=#4A212E}" />
                    <Label x:Name="DescriptionLabel" FontSize="15" TextColor="{AppThemeBinding Light=#8A6B72, Dark=#D8A7B1}" />
                    <Label x:Name="AllergyLabel" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#D84B65, Dark=#FFC2D1}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="HardwareDataBorder"
                    IsVisible="False"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#FFD1DC, Dark=#4A212E}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F0C14}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Context and Hardware Data" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}" />
                    <Image x:Name="DetailPhoto" Aspect="AspectFit" HeightRequest="180" IsVisible="False" />
                    <Label x:Name="DetailLocation" FontSize="14" FontAttributes="Italic" TextColor="{AppThemeBinding Light=#FF8DA1, Dark=#FFB3C6}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read summary"
                        CornerRadius="16"
                        BackgroundColor="#FF6B81"
                        TextColor="#FFFFFF"
                        Clicked="OnSpeakClicked"
                        SemanticProperties.Hint="Read the nutrition summary aloud" />
                <Button Grid.Column="1"
                        Text="Stop reading"
                        CornerRadius="16"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F0C14}"
                        BorderColor="{AppThemeBinding Light=#FFD1DC, Dark=#4A212E}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}"
                        Clicked="OnStopSpeechClicked"
                        SemanticProperties.Hint="Stop the current speech" />
            </Grid>

            <Button Text="Vibration reminder"
                    CornerRadius="16"
                    BackgroundColor="#FF8DA1"
                    TextColor="#FFFFFF"
                    Clicked="OnVibrateClicked"
                    SemanticProperties.Hint="Use mobile vibration as a meal reminder" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>