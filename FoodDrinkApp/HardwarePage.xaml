<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware Demo"
             BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkBgBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="5" Margin="0,0,0,10">
                <Label Text="Mobile hardware" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextPrimary}}" />
                <Label Text="Demonstrate camera, location, speech, vibration, and haptic feedback." 
                       FontSize="14" 
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextSecondary}}" />
            </VerticalStackLayout>

            <Border Stroke="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource DarkBorder}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkCardBackground}}"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="15">

                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5" VerticalOptions="Center">
                        <Label Text="Food photo" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="Capture the colour and condition of the meal." 
                               FontSize="13" 
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>

                    <Button Grid.Row="0" Grid.Column="1"
                            Text="Photo" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="44"
                            WidthRequest="85"
                            Clicked="OnTakePhotoClicked" />

                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                            HeightRequest="180"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource OffBlack}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                        <Image x:Name="FoodPhoto" 
                               Aspect="AspectFill" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Stroke="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource DarkBorder}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkCardBackground}}"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="10">

                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="5" VerticalOptions="Center">
                        <Label Text="Meal location" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="Show country, city, region, and coordinates." 
                               FontSize="13" 
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>

                    <Button Grid.Row="0" Grid.Column="1"
                            Text="Locate" 
                            BackgroundColor="{StaticResource PrimaryDark}" 
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="44"
                            WidthRequest="85"
                            Clicked="OnLocateClicked" />

                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                           x:Name="LocationLabel"
                           Text="Location has not been captured yet." 
                           FontSize="15" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextPrimary}}"
                           Margin="0,10,0,0" />

                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                           x:Name="CoordinateLabel"
                           Text="Coordinates will appear here." 
                           FontSize="12" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextSecondary}}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="Read help" 
                        BackgroundColor="{StaticResource Primary}" 
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="8"
                        Clicked="OnReadHelpClicked" />

                <Button Grid.Column="1"
                        Text="Stop speech" 
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                        TextColor="{StaticResource PrimaryDark}"
                        BorderColor="{StaticResource PrimaryDark}"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="8"
                        Clicked="OnStopSpeechClicked" />
            </Grid>

            <Label x:Name="FeedbackCountLabel" IsVisible="False" />
            <Label x:Name="HardwareStatusLabel" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>