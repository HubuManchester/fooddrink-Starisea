<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.MainPage"
             Title="NutriBite">
    <Grid RowDefinitions="Auto,*">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#FFF5F7, Dark=#1A0A0F}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#FFE1E8, Dark=#2D121B}" Offset="0.45" />
                <GradientStop Color="{AppThemeBinding Light=#FFD1DC, Dark=#1F0C14}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Padding="20,18,20,18">
            <Border StrokeThickness="0" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{AppThemeBinding Light=#FF6B81, Dark=#801D33}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light=#FF8DA1, Dark=#A62B46}" Offset="0.62" />
                        <GradientStop Color="{AppThemeBinding Light=#FFA8B5, Dark=#CC4260}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#44FF6B81" Offset="0,8" Radius="18" Opacity="0.5" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Label Text="NutriBite"
                           FontSize="31"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Grid.Row="1"
                           Text="Track nutrition, flavour, photos, and meal context in one place."
                           FontSize="15"
                           TextColor="#FFF0F5" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,3,0,0">
                        <Border BackgroundColor="#44FFFFFF" StrokeThickness="0" Padding="10,7">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="Nutrition" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#44FFFFFF" StrokeThickness="0" Padding="10,7">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="Photos" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="#44FFFFFF" StrokeThickness="0" Padding="10,7">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="Voice" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                        <Border StrokeThickness="1"
                                Stroke="#FFC2D1"
                                BackgroundColor="#FFFFFA"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <SearchBar x:Name="SearchFoodBar"
                                       Placeholder="Search foods or tags"
                                       TextChanged="OnSearchTextChanged"
                                       SearchButtonPressed="OnSearchButtonPressed"
                                       TextColor="#4A2E35"
                                       PlaceholderColor="#D8A7B1"
                                       BackgroundColor="Transparent" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="Add"
                                CornerRadius="16"
                                BackgroundColor="#FF6B81"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                Clicked="OnAddClicked" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <RefreshView Grid.Row="1" x:Name="FoodRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No matching food or drink records."
                            Margin="16,0,16,18">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#FFD1DC, Dark=#4A212E}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F0C14}"
                                Padding="0"
                                Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#22FF6B81" Offset="0,5" Radius="14" Opacity="0.3" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="6,*">
                                <BoxView BackgroundColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}" />

                                <Grid Grid.Column="1" Padding="14" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#4A2E35, Dark=#FFE8EC}"
                                               SemanticProperties.HeadingLevel="Level2" />

                                        <Label Text="{Binding MacroSummary}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}" />

                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="📍" FontSize="11">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding LocationName}" Value="">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding LocationName}" Value="{x:Null}">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding LocationName}" 
                                                   FontSize="12" 
                                                   TextColor="{AppThemeBinding Light=#8A6B72, Dark=#D8A7B1}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </HorizontalStackLayout>

                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFE1E8, Dark=#4A212E}" Padding="8,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding CaloriesLabel}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#D84B65, Dark=#FFC2D1}" />
                                            </Border>
                                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFF5F7, Dark=#2D121B}" Padding="8,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Category}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#FF8DA1, Dark=#FFB3C6}" />
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                                        <Border WidthRequest="60" HeightRequest="60" StrokeThickness="0" BackgroundColor="Transparent">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                        </Border>

                                        <Button Text="Details"
                                                Padding="12,4"
                                                CornerRadius="12"
                                                FontSize="12"
                                                BackgroundColor="{AppThemeBinding Light=#FF6B81, Dark=#FF9EAF}"
                                                TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#4A0014}"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnDetailsClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>