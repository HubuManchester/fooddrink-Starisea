<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#FFB6C1</Color>
    <Color x:Key="PrimaryDark">#FF69B4</Color>
    <Color x:Key="PrimaryDarkText">#4A4A4A</Color>
    <Color x:Key="Secondary">#FFF0F5</Color>
    <Color x:Key="SecondaryDarkText">#FF69B4</Color>
    <Color x:Key="Tertiary">#FFE4E1</Color>

    <Color x:Key="DarkBgBackground">#121212</Color>
    <Color x:Key="DarkCardBackground">#1E1E1E</Color>
    <Color x:Key="DarkTextPrimary">#E0E0E0</Color>
    <Color x:Key="DarkTextSecondary">#A0A0A0</Color>
    <Color x:Key="DarkBorder">#2C2C2C</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#FF1493</Color>
    <Color x:Key="MidnightBlue">#FFF8F9</Color>
    <Color x:Key="OffBlack">#242424</Color>

    <Color x:Key="Gray100">#FFFDFE</Color>
    <Color x:Key="Gray200">#FDF5E6</Color>
    <Color x:Key="Gray300">#EADBC8</Color>
    <Color x:Key="Gray400">#ACACAC</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>