<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkBgBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="5" Margin="0,0,0,10">
                <Label Text="Settings" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextPrimary}}" />
            </VerticalStackLayout>

            <Border Stroke="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource DarkBorder}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkCardBackground}}"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Accessibility settings" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextPrimary}}" />
                        <Label Text="Large text takes effect immediately and remains active when switching pages." 
                               FontSize="13" 
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource DarkBorder}}" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" 
                               Text="Theme mode" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDark}" 
                               VerticalOptions="Center" />

                        <Picker Grid.Column="1"
                                x:Name="ThemePicker"
                                Title="Select Theme"
                                TitleColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextPrimary}}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextPrimary}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                                HorizontalTextAlignment="Center"
                                HeightRequest="40"
                                WidthRequest="130"
                                VerticalOptions="Center"
                                SelectedIndexChanged="OnThemeChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Unspecified</x:String>
                                    <x:String>Light Theme</x:String>
                                    <x:String>Dark Theme</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource DarkBorder}}" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Large text mode" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="Increase text size for accessibility demonstration." 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextSecondary}}" />
                        </VerticalStackLayout>

                        <Switch Grid.Column="1"
                                x:Name="LargeTextSwitch"
                                ThumbColor="{StaticResource PrimaryDark}" 
                                OnColor="{StaticResource Primary}"
                                VerticalOptions="Center"
                                Toggled="OnLargeTextToggled" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border Stroke="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource DarkBorder}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkCardBackground}}"
                    Padding="20"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LargeTextPreviewTitle"
                           Text="Large text preview" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextPrimary}}" />
                    <Label x:Name="LargeTextPreviewBody"
                           Text="Turn on the switch to enlarge this preview and other page text." 
                           FontSize="13" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource DarkTextSecondary}}" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="SettingsStatusLabel"
                   Text="Theme preference updated." 
                   FontSize="14" 
                   TextColor="{StaticResource PrimaryDark}" 
                   FontAttributes="Italic"
                   HorizontalOptions="Start"
                   Margin="5,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>